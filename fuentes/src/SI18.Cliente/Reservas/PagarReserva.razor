@page "/reservas/{Id:long}/pago"
@using SI18.Contratos.Reservas
@inject ClienteApi Api
@inject EstadoSesion Sesion
@inject NavigationManager Navegacion

@* Pago de una reserva pendiente (specs/002-reservar-pagar/research.md E11; tasks.md T025). El resultado se
   muestra en la misma página: el formulario desaparece y el foco pasa al encabezado del resultado. *@

<PageTitle>Pagar la reserva · SI-18</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Pagar la reserva</MudText>

<MensajeAccesible @ref="_mensaje" />

@if (_reserva is not null)
{
    <ResumenReserva Pista="@_reserva.Pista" Centro="@_reserva.Centro" Fecha="_reserva.Fecha"
                    HoraInicio="@_reserva.HoraInicio" HoraFin="@_reserva.HoraFin" Importe="_reserva.Importe" />

    @if (_resultado == Resultado.Pendiente)
    {
        <p>Paga antes de las @_reserva.HoraLimitePago; después la reserva caduca.</p>

        <form @onsubmit="Pagar" novalidate class="formulario-pago">
            <MudTextField T="string" @ref="_campoTarjeta" @bind-Value="_numeroTarjeta" Label="Número de tarjeta" Variant="Variant.Outlined"
                          InputMode="InputMode.numeric" UserAttributes="AtributosTarjeta"
                          HelperText="16 dígitos; es una tarjeta ficticia"
                          Error="_errorTarjeta is not null" ErrorText="@_errorTarjeta" />
            @* MudBlazor 8 quita aria-describedby del campo cuando muestra el error (y no deja poner otro), y el texto
               del error no tiene id: sin esto, el lector de pantalla diría «no válido» pero no el motivo (T042, T043).
               role="alert" lo anuncia al aparecer sin sacar el foco del campo; aria-errormessage lo asocia al campo. *@
            @if (_errorTarjeta is not null)
            {
                <span id="error-tarjeta" role="alert" class="solo-lector">@_errorTarjeta</span>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_enviando">
                Pagar @FormatoEs.Importe(_reserva.Importe)
            </MudButton>
        </form>
    }
    else if (_resultado == Resultado.Confirmada)
    {
        <section aria-labelledby="encabezado-resultado" class="resultado-pago">
            <h2 id="encabezado-resultado" tabindex="-1" @ref="_encabezado" class="mud-typography mud-typography-h5 encabezado-resultado">
                Reserva confirmada
            </h2>
            <CodigoAcceso Codigo="@(_reserva.CodigoAcceso ?? string.Empty)" Descripcion="@TextosReservas.Descripcion(_reserva)" />
            <MudButton Href="/mis-reservas" Variant="Variant.Text" Color="Color.Primary">Ver mis reservas</MudButton>
        </section>
    }
    else
    {
        <section aria-labelledby="encabezado-resultado" class="resultado-pago">
            <h2 id="encabezado-resultado" tabindex="-1" @ref="_encabezado" class="mud-typography mud-typography-h5 encabezado-resultado">
                @Encabezado(_resultado)
            </h2>
            <MudButton Href="/buscar-pistas" Variant="Variant.Text" Color="Color.Primary">Volver a buscar pistas</MudButton>
        </section>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private enum Resultado { Pendiente, Confirmada, Caducada, Rechazado, NoPagable, YaEmpezada }

    // Si la reserva ya llega caducada no hay respuesta de error de la que leer el detalle; puede haber caducado
    // por tiempo, por un pago rechazado o por un cierre, así que el texto no dice por qué.
    private const string TextoYaCaducada = "Esta reserva ha caducado sin pagarse. Si la franja sigue libre, haz una reserva nueva.";
    private const string TextoYaCancelada = "Esta reserva está cancelada y no se puede pagar.";

    private Dictionary<string, object> AtributosTarjeta => _errorTarjeta is null
        ? new() { ["autocomplete"] = "cc-number" }
        : new() { ["autocomplete"] = "cc-number", ["aria-errormessage"] = "error-tarjeta" };

    private MensajeAccesible _mensaje = null!;
    private ElementReference _encabezado;
    private MudTextField<string> _campoTarjeta = null!;
    private bool _enfocarCampo;
    private ReservaDto? _reserva;
    private Resultado _resultado;
    private string? _numeroTarjeta;
    private string? _errorTarjeta;
    private bool _enviando;
    private bool _enfocarResultado;
    private (string Texto, Severity Tipo)? _mensajePendiente;

    protected override async Task OnInitializedAsync()
    {
        switch (await AccesoReservas.Comprobar(Sesion))
        {
            case Acceso.SinSesion:
                Navegacion.NavigateTo(ClienteApi.RutaInicioSesion);
                return;
            case Acceso.SinPermiso:
                _mensajePendiente = (AccesoReservas.AvisoSinPermiso, Severity.Warning);
                return;
        }

        try
        {
            _reserva = await Api.GetAsync<ReservaDto>($"/api/reservas/{Id}");
            _resultado = _reserva.Estado switch
            {
                EstadoReserva.Confirmada => Resultado.Confirmada,
                EstadoReserva.Caducada => Resultado.Caducada,
                EstadoReserva.Cancelada => Resultado.NoPagable,
                _ => Resultado.Pendiente,
            };

            _mensajePendiente = _resultado switch
            {
                Resultado.Caducada => (TextoYaCaducada, Severity.Warning),
                Resultado.NoPagable => (TextoYaCancelada, Severity.Error),
                _ => null,
            };
        }
        catch (ErrorApi error)
        {
            _mensajePendiente = (error.Detalle, Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // MensajeAccesible solo existe después del primer renderizado.
        if (_mensajePendiente is { } pendiente)
        {
            _mensajePendiente = null;
            _mensaje.Mostrar(pendiente.Texto, pendiente.Tipo);
        }

        // El formulario ha desaparecido: el foco va al encabezado del resultado para no perderse en <body>.
        if (_enfocarResultado)
        {
            _enfocarResultado = false;
            await _encabezado.FocusAsync();
        }

        // Error de formato de la tarjeta: el foco queda en el campo, donde está el error (T035).
        if (_enfocarCampo)
        {
            _enfocarCampo = false;
            await _campoTarjeta.FocusAsync();
        }
    }

    private async Task Pagar()
    {
        if (_enviando || _reserva is null)
        {
            return;
        }

        _enviando = true;
        _errorTarjeta = null;
        _mensaje.Limpiar();

        try
        {
            _reserva = await Api.PostAsync<PeticionPago, ReservaDto>(
                $"/api/reservas/{Id}/pago", new PeticionPago(_numeroTarjeta ?? string.Empty));
            MostrarResultado(Resultado.Confirmada, "Reserva confirmada.", Severity.Success);
        }
        catch (ErrorApi error) when (error.Errores.TryGetValue("numeroTarjeta", out var errores))
        {
            // Formato de la tarjeta: el error va en el propio campo; el formulario se queda.
            _errorTarjeta = string.Join(' ', errores);
            _enfocarCampo = true;
        }
        catch (ErrorApi error) when (error.Codigo == "RESERVA_CADUCADA")
        {
            MostrarResultado(Resultado.Caducada, error.Detalle, Severity.Warning);
        }
        catch (ErrorApi error) when (error.Codigo == "FRANJA_YA_EMPEZADA")
        {
            // RF-009a: la franja empezó antes de pagar; la reserva queda caducada y no se puede reintentar.
            MostrarResultado(Resultado.YaEmpezada, error.Detalle, Severity.Warning);
        }
        catch (ErrorApi error) when (error.Codigo == "PAGO_RECHAZADO")
        {
            MostrarResultado(Resultado.Rechazado, error.Detalle, Severity.Error);
        }
        catch (ErrorApi error) when (error.Codigo == "TRANSICION_NO_PERMITIDA")
        {
            MostrarResultado(Resultado.NoPagable, error.Detalle, Severity.Error);
        }
        catch (ErrorApi error)
        {
            _mensaje.Mostrar(error.Detalle, Severity.Error);
        }
        finally
        {
            _enviando = false;
        }
    }

    private static string Encabezado(Resultado resultado) => resultado switch
    {
        Resultado.Caducada => "La reserva ha caducado",
        Resultado.Rechazado => "El pago no se ha completado",
        Resultado.NoPagable => "Esta reserva ya no se puede pagar",
        Resultado.YaEmpezada => "La franja ya ha empezado",
        _ => throw new ArgumentOutOfRangeException(nameof(resultado), resultado, null),
    };

    // El resultado nunca se transmite solo con color: siempre hay encabezado y texto (T035).
    private void MostrarResultado(Resultado resultado, string texto, Severity tipo)
    {
        _numeroTarjeta = null;
        _resultado = resultado;
        _enfocarResultado = true;
        _mensaje.Mostrar(texto, tipo);
    }
}
