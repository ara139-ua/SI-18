@inherits LayoutComponentBase
@inject EstadoSesion Sesion
@inject NavigationManager Navegacion

@* Layout común (research.md R16) con el menú por rol (tasks.md T056). Cada módulo añade sus entradas en
   el hueco de su rol; el resto del layout no se toca. *@

<MudThemeProvider Theme="_tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="salto-contenido" href="#contenido" @onclick="IrAlContenido" @onclick:preventDefault>Ir al contenido</a>

<MudLayout>
    @* Fixed="false": la barra va en el flujo y puede crecer a varias líneas en pantallas estrechas (WCAG 1.4.10);
       en app.css se queda pegada arriba (sticky) a partir de 600 px. *@
    <MudAppBar Elevation="1" Fixed="false">
        <MudLink Href="/" Color="Color.Inherit" Typo="Typo.h6" Underline="Underline.None" Class="ml-2">
            SI-18 · Reservas deportivas
        </MudLink>
        <MudSpacer />
        <nav aria-label="Menú principal" class="menu-principal">
            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Roles="ciudadano,representante_club" Context="reserva">
                        <MudButton Href="/buscar-pistas" Color="Color.Inherit" Variant="Variant.Text">Buscar pistas</MudButton>
                        <MudButton Href="/mis-reservas" Color="Color.Inherit" Variant="Variant.Text">Mis reservas</MudButton>
                        @* Hueco de Reservas (spec-002, 003). *@
                        @* Hueco de CursosInformes (spec-004): cursos. *@
                    </AuthorizeView>
                    <AuthorizeView Roles="representante_club" Context="club">
                        <MudButton Href="/franjas-fijas" Color="Color.Inherit" Variant="Variant.Text">Franjas fijas</MudButton>
                    </AuthorizeView>
                    <AuthorizeView Roles="personal_centro" Context="personal">
                        <MudButton Href="/validar-acceso" Color="Color.Inherit" Variant="Variant.Text">Validar acceso</MudButton>
                        @* Hueco de Cancelaciones (spec-007): cierres. *@
                    </AuthorizeView>
                    <AuthorizeView Roles="tecnico_concejalia" Context="tecnico">
                        <MudButton Href="/franjas-fijas/revision" Color="Color.Inherit" Variant="Variant.Text">Revisar franjas fijas</MudButton>
                        @* Hueco de CursosInformes (spec-008): informes. *@
                    </AuthorizeView>

                    <MudButton Href="/mis-avisos" Color="Color.Inherit" Variant="Variant.Text">Mis avisos</MudButton>
                    <MudText Typo="Typo.body2" Class="mx-3 nombre-usuario">@context.User.Identity?.Name</MudText>
                    <MudButton OnClick="CerrarSesion" Color="Color.Inherit" Variant="Variant.Outlined">Cerrar sesión</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/iniciar-sesion" Color="Color.Inherit" Variant="Variant.Outlined">Iniciar sesión</MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </MudAppBar>

    <MudMainContent>
        <main id="contenido" tabindex="-1" @ref="_contenido">
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _tema = Tema.Crear();
    private ElementReference _contenido;

    // Con <base href="/">, un enlace a «#contenido» navegaría a la raíz: se mueve el foco desde código.
    private async Task IrAlContenido() => await _contenido.FocusAsync();

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesion();
        Navegacion.NavigateTo("/");
    }
}
