# Copia este fichero a .env y sustituye los valores <cambia-esto>. .env NUNCA se sube al repositorio
# (constitución, principio V).

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=si18
POSTGRES_PASSWORD=<cambia-esto>
POSTGRES_DB=si18
POSTGRES_PORT=5432

# API (alternativa a dotnet user-secrets)
ConnectionStrings__Si18=Host=localhost;Port=5432;Database=si18;Username=si18;Password=<cambia-esto>

# Contraseña común de los usuarios de demostración ficticios
SI18_CLAVE_DEMO=<cambia-esto>

# true = aplica migraciones y siembra los datos de demostración al arrancar la API
SI18_SEMBRAR_DATOS=true

# Opcional: base de datos para las pruebas de integración en lugar de Testcontainers
SI18_TEST_CONNECTION=
